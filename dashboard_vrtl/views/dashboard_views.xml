<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Form View -->
    <record id="dashboard_form_view" model="ir.ui.view">
        <field name="name">dashboard.dashboard.form</field>
        <field name="model">dashboard.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard">
                <header>
                    <button name="action_open_dashboard" type="object" string="View Dashboard" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Dashboard Name"/></h1>
                    </div>
                    <group col="2">
                        <group>
                            <field name="key"/>
                            <field name="category"/>
                            <field name="icon"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="auto_reload_duration"/>
                            <field name="cache_ttl"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Access">
                            <group>
                                <field name="access_by" widget="radio"/>
                                <field name="group_ids" widget="many2many_tags" invisible="access_by != 'access_group'"/>
                                <field name="user_ids" widget="many2many_tags" invisible="access_by != 'user'"/>
                            </group>
                        </page>
                        <page string="Charts" name="charts">
                            <field name="chart_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="chart_type"/>
                                    <field name="metric_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Filters" name="filters">
                            <field name="filter_ids">
                                <list editable="bottom">
                                    <field name="key"/>
                                    <field name="name"/>
                                    <field name="filter_type"/>
                                    <field name="optional"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alerts" name="alerts">
                            <field name="alert_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="metric_id"/>
                                    <field name="condition" required="1"/>
                                    <field name="severity"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Email" name="email">
                            <group>
                                <div class="alert alert-info" style="margin-bottom:10px">
                                    <strong>Scheduled Emails:</strong> charts are captured as PNG when this
                                    dashboard is opened and delivered by the "Dashboard: Send Scheduled Emails" cron.
                                </div>
                                <field name="dashboard_mail_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="is_automated"/>
                                        <field name="interval_number"/>
                                        <field name="interval_type"/>
                                        <field name="next_run"/>
                                        <field name="last_sent_at"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Menu">
                            <group>
                                <field name="parent_menu_id"/>
                                <field name="menu_sequence"/>
                                <field name="menu_active"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Dashboard List View -->
    <record id="dashboard_list_view" model="ir.ui.view">
        <field name="name">dashboard.dashboard.list</field>
        <field name="model">dashboard.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="key"/>
                <field name="category"/>
                <field name="chart_count"/>
                <field name="menu_active"/>
            </list>
        </field>
    </record>

    <!-- Dashboard Search View -->
    <record id="dashboard_search_view" model="ir.ui.view">
        <field name="name">dashboard.dashboard.search</field>
        <field name="model">dashboard.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="key"/>
                <field name="category"/>
                <filter name="active_menus" string="Active Menus" domain="[('menu_active','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">dashboard.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Email Schedule Form/List -->
    <record id="dashboard_mail_form_view" model="ir.ui.view">
        <field name="name">dashboard.mail.form</field>
        <field name="model">dashboard.mail</field>
        <field name="arch" type="xml">
            <form string="Email Schedule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Schedule Name"/></h1>
                    </div>
                    <group col="2">
                        <group>
                            <field name="dashboard_id" required="1"/>
                            <field name="chart_ids" widget="many2many_tags"/>
                            <field name="is_automated"/>
                        </group>
                        <group>
                            <field name="interval_number"/>
                            <field name="interval_type"/>
                            <field name="next_run"/>
                            <field name="last_sent_at" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Recipients"/>
                    <group>
                        <field name="recipient_ids" widget="many2many_tags"/>
                        <field name="recipient_group_ids" widget="many2many_tags"/>
                        <field name="recipient_user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dashboard_mail_list_view" model="ir.ui.view">
        <field name="name">dashboard.mail.list</field>
        <field name="model">dashboard.mail</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="dashboard_id"/>
                <field name="is_automated"/>
                <field name="next_run"/>
                <field name="last_sent_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="dashboard_mail_action" model="ir.actions.act_window">
        <field name="name">Email Schedules</field>
        <field name="res_model">dashboard.mail</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
