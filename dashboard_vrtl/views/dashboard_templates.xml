<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main dashboard rendering template -->
    <template id="DashboardAmcharts" name="Dashboard AmCharts View">
        <div t-name="dashboard_vrtl.DashboardAmcharts" class="o_dashboard_vrtl">
            <!-- Filter bar -->
            <div class="o_dashboard_filters" t-if="state.filters and state.filters.length">
                <t t-foreach="state.filters" t-as="filter" t-key="filter.key">
                    <span class="o_filter_badge badge bg-light text-dark me-2">
                        <t t-esc="filter.label"/>
                        <button type="button" class="btn-close btn-close-sm ms-1"
                                t-on-click="() => this.removeFilter(filter.key)"/>
                    </span>
                </t>
            </div>

            <!-- Drill-down breadcrumbs -->
            <div class="o_dashboard_breadcrumb" t-if="state.drillStack and state.drillStack.length">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item" t-on-click="() => this.navigateDrill(-1)">
                            <a href="#">Dashboard</a>
                        </li>
                        <t t-foreach="state.drillStack" t-as="step" t-key="step.level">
                            <li class="breadcrumb-item"
                                t-att-class="step.level === state.drillStack.length-1 ? 'active' : ''"
                                t-on-click="() => this.navigateDrill(step.level)">
                                <a href="#" t-if="step.level &lt; state.drillStack.length-1" t-esc="step.label"/>
                                <span t-else="" t-esc="step.label"/>
                            </li>
                        </t>
                    </ol>
                </nav>
            </div>

            <!-- Chart grid -->
            <div class="grid-stack"/>
        </div>
    </template>

    <!-- Chart wrapper template -->
    <template id="DashboardChartWrapper" name="Chart Wrapper">
        <div t-name="dashboard_vrtl.DashboardChartWrapper" class="o_dashboard_chart_wrapper">
            <div class="o_chart_header">
                <h5 t-esc="props.chart.name"/>
                <span class="o_chart_actions" t-if="props.editable">
                    <i class="fa fa-cog" t-on-click="() => this.editChart(props.chart.id)"/>
                </span>
            </div>
            <div class="o_chart_body" t-att-class="'o_chart_' + props.chart.chart_type">
                <t t-if="props.chart.data and !props.chart.data.error">
                    <t t-call="dashboard_vrtl.ChartComponent"/>
                </t>
                <t t-else="">
                    <div class="o_chart_error alert alert-warning">
                        <t t-esc="props.chart.data.message or 'No data to display'"/>
                    </div>
                </t>
            </div>
        </div>
    </template>

    <!-- Dynamic chart component dispatch -->
    <template id="ChartComponent" name="Chart Component Dispatcher">
        <div t-name="dashboard_vrtl.ChartComponent">
            <BarChart t-if="props.chart.chart_type === 'bar_chart'" chartId="props.chart.id"
                      name="props.chart.name" theme="props.chart.theme" recordSets="props.chart.data"/>
            <LineChart t-if="props.chart.chart_type === 'line_chart'" chartId="props.chart.id"
                       name="props.chart.name" theme="props.chart.theme" recordSets="props.chart.data"/>
            <PieChart t-if="props.chart.chart_type === 'pie_chart'" chartId="props.chart.id"
                      name="props.chart.name" theme="props.chart.theme" recordSets="props.chart.data"/>
            <KPIView t-if="props.chart.chart_type === 'kpi'" chartId="props.chart.id"
                     name="props.chart.name" theme="props.chart.theme" recordSets="props.chart.data"/>
            <KanbanView t-if="props.chart.chart_type === 'kanban'" chartId="props.chart.id"
                        name="props.chart.name" theme="props.chart.theme" recordSets="props.chart.data"/>
        </div>
    </template>
</odoo>
