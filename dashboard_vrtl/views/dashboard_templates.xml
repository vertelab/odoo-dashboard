<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main dashboard rendering template -->
    <template id="DashboardAmcharts" name="Dashboard AmCharts View">
        <div t-name="dashboard_vrtl.DashboardAmcharts" class="o_dashboard_vrtl" t-ref="root">
            <!-- Loading -->
            <div t-if="state.loading" class="o_dashboard_loading d-flex justify-content-center p-5">
                <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
            </div>

            <!-- Filter bar -->
            <div class="o_dashboard_filters" t-if="state.filters and state.filters.length">
                <t t-foreach="state.filters" t-as="filter" t-key="filter.key">
                    <span class="o_filter_badge badge bg-light text-dark me-2">
                        <t t-esc="filter.label"/>
                        <button type="button" class="btn-close btn-close-sm ms-1"
                                t-on-click="() => this.removeFilter(filter.key)"/>
                    </span>
                </t>
            </div>

            <!-- Drill-down breadcrumbs -->
            <div class="o_dashboard_breadcrumb" t-if="state.drillStack and state.drillStack.length">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item" t-on-click="() => this.navigateDrill(-1)">
                            <a href="#">Dashboard</a>
                        </li>
                        <t t-foreach="state.drillStack" t-as="step" t-key="step.level">
                            <li class="breadcrumb-item"
                                t-att-class="step.level === state.drillStack.length-1 ? 'active' : ''"
                                t-on-click="() => this.navigateDrill(step.level)">
                                <a href="#" t-if="step.level &lt; state.drillStack.length-1" t-esc="step.label"/>
                                <span t-else="" t-esc="step.label"/>
                            </li>
                        </t>
                    </ol>
                </nav>
            </div>

            <!-- Chart grid -->
            <div class="grid-stack" t-att-class="state.charts and state.charts.length ? '' : 'o_dashboard_empty'">
                <t t-foreach="state.charts" t-as="chart" t-key="chart.id">
                    <div class="grid-stack-item"
                         t-att-gs-x="chart.x" t-att-gs-y="chart.y"
                         t-att-gs-w="chart.w" t-att-gs-h="chart.h">
                        <div class="grid-stack-item-content">
                            <DashboardChartItem chart="chart" editable="state.editable"/>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </template>
</odoo>
