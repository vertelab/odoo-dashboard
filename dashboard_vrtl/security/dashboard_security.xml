<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category -->
    <record id="module_category_dashboard" model="ir.module.category">
        <field name="name">BI Dashboard</field>
        <field name="description">Manage dashboards, metrics, charts, and alerts</field>
        <field name="sequence">20</field>
    </record>

    <!-- Groups -->
    <record id="group_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_dashboard"/>
    </record>

    <record id="group_dashboard_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <!-- Dashboard ir.rule: users see dashboards assigned to them or open dashboards -->
        <record id="dashboard_user_rule" model="ir.rule">
            <field name="name">Dashboard: User Access</field>
            <field name="model_id" ref="model_dashboard_dashboard"/>
            <field name="domain_force">[
                '|', ('user_ids', 'in', user.id),
                     ('user_ids', '=', False),
                '|', ('company_id', '=', False),
                     ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_dashboard_user'))]"/>
        </record>

        <!-- Dashboard ir.rule: managers see all dashboards in their companies -->
        <record id="dashboard_manager_rule" model="ir.rule">
            <field name="name">Dashboard: Manager Access</field>
            <field name="model_id" ref="model_dashboard_dashboard"/>
            <field name="domain_force">[
                '|', ('company_id', '=', False),
                     ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_dashboard_manager'))]"/>
        </record>

        <!-- Chart ir.rule: users see charts where they belong to chart_group_ids OR chart has no restriction -->
        <record id="dashboard_chart_user_rule" model="ir.rule">
            <field name="name">Chart: User Access</field>
            <field name="model_id" ref="model_dashboard_chart"/>
            <field name="domain_force">[
                '|', ('chart_group_ids', 'in', user.groups_id.ids),
                     ('chart_group_ids', '=', False),
                '|', ('company_id', '=', False),
                     ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_dashboard_user'))]"/>
        </record>

        <!-- Chart ir.rule: managers see all charts in their companies -->
        <record id="dashboard_chart_manager_rule" model="ir.rule">
            <field name="name">Chart: Manager Access</field>
            <field name="model_id" ref="model_dashboard_chart"/>
            <field name="domain_force">[
                '|', ('company_id', '=', False),
                     ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_dashboard_manager'))]"/>
        </record>

        <!-- Metric ir.rule -->
        <record id="dashboard_metric_rule" model="ir.rule">
            <field name="name">Metric: Company Access</field>
            <field name="model_id" ref="model_dashboard_metric"/>
            <field name="domain_force">[
                '|', ('company_id', '=', False),
                     ('company_id', 'in', company_ids)
            ]</field>
        </record>

        <!-- Alert ir.rule -->
        <record id="dashboard_alert_rule" model="ir.rule">
            <field name="name">Alert: Company Access</field>
            <field name="model_id" ref="model_dashboard_alert"/>
            <field name="domain_force">[
                '|', ('company_id', '=', False),
                     ('company_id', 'in', company_ids)
            ]</field>
        </record>
    </data>
</odoo>
