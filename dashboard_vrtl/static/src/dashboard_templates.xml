<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- Main dashboard rendering template -->
    <div t-name="dashboard_vrtl.DashboardAmcharts" class="o_dashboard_vrtl" t-ref="root">
        <!-- Loading -->
        <div t-if="state.loading" class="o_dashboard_loading d-flex justify-content-center p-5">
            <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
        </div>

        <!-- Global filter bar -->
        <div class="o_dashboard_global_filters d-flex flex-wrap align-items-center gap-2 p-2 bg-light border-bottom"
             t-if="state.filterBar and state.filterBar.length">
            <t t-foreach="state.filterBar" t-as="gfilter" t-key="gfilter.key">
                <t t-if="gfilter.type === 'date_range'">
                    <div class="o_global_filter d-inline-flex align-items-center me-3">
                        <label class="me-1 text-muted" t-esc="gfilter.name"/>
                        <input type="date" class="form-control form-control-sm d-inline-block w-auto"
                               t-att-value="globalFilters.date_from || ''"
                               t-on-change="(e) => this.onGlobalDateRange('from', e.target.value)"/>
                        <span class="mx-1">→</span>
                        <input type="date" class="form-control form-control-sm d-inline-block w-auto"
                               t-att-value="globalFilters.date_to || ''"
                               t-on-change="(e) => this.onGlobalDateRange('to', e.target.value)"/>
                        <t t-foreach="gfilter.shortcuts or []" t-as="sc" t-key="sc.label">
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1"
                                    t-on-click="() => this.onGlobalShortcut(gfilter, sc)">
                                <t t-esc="sc.label"/>
                            </button>
                        </t>
                    </div>
                </t>
                <t t-elif="gfilter.type === 'many2one'">
                    <div class="o_global_filter d-inline-flex align-items-center me-3">
                        <label class="me-1 text-muted" t-esc="gfilter.name"/>
                        <select class="form-select form-select-sm d-inline-block w-auto"
                                t-on-change="(e) => this.onGlobalMany2oneChange(gfilter, e.target.value)">
                            <option value="">— All —</option>
                            <t t-foreach="state.many2oneOptions[gfilter.key] or []" t-as="opt" t-key="opt[0]">
                                <option t-att-value="opt[0]"
                                        t-att-selected="(globalFilters[gfilter.field] || '') == opt[0] ? 'selected' : null">
                                    <t t-esc="opt[1]"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </t>
            </t>
        </div>

        <!-- Cross-chart filter badges -->
        <div class="o_dashboard_filters" t-if="state.filters and state.filters.length">
            <t t-foreach="state.filters" t-as="filter" t-key="filter.key">
                <span class="o_filter_badge badge bg-light text-dark me-2">
                    <t t-esc="filter.label"/>
                    <button type="button" class="btn-close btn-close-sm ms-1"
                            t-on-click="() => this.removeFilter(filter.key)"/>
                </span>
            </t>
        </div>

        <!-- Drill-down breadcrumbs -->
        <div class="o_dashboard_breadcrumb" t-if="state.drillStack and state.drillStack.length">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item" t-on-click="() => this.navigateDrill(-1)">
                        <a href="#">Dashboard</a>
                    </li>
                    <t t-foreach="state.drillStack" t-as="step" t-key="step.level">
                        <li class="breadcrumb-item"
                            t-att-class="step.level === state.drillStack.length-1 ? 'active' : ''"
                            t-on-click="() => this.navigateDrill(step.level)">
                            <a href="#" t-if="step.level &lt; state.drillStack.length-1" t-esc="step.label"/>
                            <span t-else="" t-esc="step.label"/>
                        </li>
                    </t>
                </ol>
            </nav>
        </div>

        <!-- Layout toolbar -->
        <div class="o_dashboard_toolbar d-flex justify-content-end align-items-center gap-2 px-2 py-1">
            <t t-if="!state.editable">
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        t-on-click="toggleEdit">
                    <i class="fa fa-edit me-1"/>Edit Layout
                </button>
            </t>
            <t t-else="">
                <button type="button" class="btn btn-sm btn-success"
                        t-on-click="saveLayout">
                    <i class="fa fa-check me-1"/>Save
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        t-on-click="cancelEdit">
                    Cancel
                </button>
            </t>
        </div>

        <!-- Chart grid -->
        <div class="grid-stack" t-att-class="state.charts and state.charts.length ? '' : 'o_dashboard_empty'">
            <t t-foreach="state.charts" t-as="chart" t-key="chart.id">
                <div class="grid-stack-item"
                     t-att-gs-id="chart.id"
                     t-att-gs-x="chart.x" t-att-gs-y="chart.y"
                     t-att-gs-w="chart.w" t-att-gs-h="chart.h">
                    <div class="grid-stack-item-content">
                        <DashboardChartItem chart="chart" editable="state.editable" onFilterEvent="(ev) => this.onChartFilter(ev)"/>
                    </div>
                </div>
            </t>
        </div>
    </div>
</templates>
