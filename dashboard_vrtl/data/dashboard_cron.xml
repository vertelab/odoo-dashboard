<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Alert evaluator — runs every 15 minutes -->
    <record id="ir_cron_alert_evaluator" model="ir.cron">
        <field name="name">Dashboard: Evaluate Alerts</field>
        <field name="model_id" ref="model_dashboard_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_evaluate_all()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Cache cleanup — runs every 15 minutes -->
    <record id="ir_cron_cache_cleanup" model="ir.cron">
        <field name="name">Dashboard: Cleanup Expired Cache</field>
        <field name="model_id" ref="model_dashboard_cache"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_expired()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Scheduled email delivery — runs every 15 minutes -->
    <record id="ir_cron_send_dashboard_mail" model="ir.cron">
        <field name="name">Dashboard: Send Scheduled Emails</field>
        <field name="model_id" ref="model_dashboard_mail"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_due()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Alert activity type -->
    <record id="mail_activity_alert" model="mail.activity.type">
        <field name="name">Dashboard Alert</field>
        <field name="icon">fa-bell</field>
        <field name="sequence">30</field>
    </record>
</odoo>
